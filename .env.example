# For `npm run dev`: copy to .env.local. The live project's values are in .env.production;
# use those, or point at a separate Supabase project for testing.
VITE_SUPABASE_URL=
# The publishable key (sb_publishable_...) or the legacy anon key. Never the secret key.
VITE_SUPABASE_ANON_KEY=
# Optional
VITE_CONTACT_EMAIL=hello@ekoagsin.org
