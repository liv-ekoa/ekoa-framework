{
  "name": "ekoa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ekoa — implementation network for student-led school sustainability",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed:sql": "esbuild scripts/generate-seed-sql.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-seed.mjs --log-level=warning && node node_modules/.cache/gen-seed.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "test:db": "bash scripts/test-security.sh"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource-variable/bricolage-grotesque": "5.2.8",
    "@fontsource/atkinson-hyperlegible": "5.2.6",
    "@fontsource/caveat": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@supabase/supabase-js": "2.117.3",
    "gsap": "3.13.0",
    "leaflet": "1.9.4",
    "lenis": "1.1.13",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
